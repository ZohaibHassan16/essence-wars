# AI-friendly environment defaults
# ================================
# These settings reduce verbose CLI output, which saves context tokens
# when working with LLM coding assistants (Claude Code, Cursor, etc.)
#
# Loaded automatically by direnv when you cd into this directory.
# Run `direnv allow` once to enable.

# Disable colors in CLI output (many tools respect this)
export NO_COLOR=1

# Cargo-specific settings (backup for .cargo/config.toml)
export CARGO_TERM_COLOR=never
export CARGO_TERM_PROGRESS_WHEN=never

# Python - reduce pip verbosity
export PIP_QUIET=1

# Node/npm - reduce verbosity
export npm_config_loglevel=warn

# Activate Python virtual environment if it exists
if [ -d ".venv" ]; then
  source .venv/bin/activate
fi
